#!/usr/bin/env bash
# expo-local-doctor — Diagnose and fix your Expo local build environment on Linux.
# https://github.com/feri-irawan/expo-local-doctor
#
# Usage:
#   expo-local-doctor                Check system readiness
#   expo-local-doctor --fix          Auto-install missing dependencies
#   expo-local-doctor --sdk <ver>    Target a specific Expo SDK version
#   expo-local-doctor --help         Show help
#   expo-local-doctor --version      Show version

set -euo pipefail

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
VERSION="1.3.4"
SCRIPT_NAME="expo-local-doctor"

# Android command-line tools download version (latest stable)
ANDROID_CMDLINE_TOOLS_VERSION="11076708"

# ---------------------------------------------------------------------------
# Expo SDK → Dependency version mapping table
# Format: sdk_version|min_node|min_jdk|compile_sdk|build_tools|ndk
# Source: https://docs.expo.dev/versions/latest/
# ---------------------------------------------------------------------------
SDK_VERSION_MAP=(
    "57|22.13.0|17|36|36.0.0|27.1.12297006"
    "56|20.19.0|17|36|36.0.0|27.1.12297006"
    "55|20.19.4|17|36|36.0.0|27.1.12297006"
    "54|20.19.0|17|36|36.0.0|27.1.12297006"
    "53|18.18.0|17|35|35.0.0|26.1.10909125"
    "52|18.18.0|17|35|35.0.0|26.1.10909125"
    "51|18.18.0|17|34|34.0.0|26.1.10909125"
    "50|18.18.0|17|34|34.0.0|25.1.8937393"
)

# Default fallback (latest known SDK)
DEFAULT_SDK_VERSION=57

# These will be set by resolve_sdk_versions()
MIN_NODE_VERSION=""
MIN_JDK_VERSION=""
ANDROID_PLATFORM_VERSION=""
ANDROID_BUILD_TOOLS_VERSION=""
ANDROID_NDK_VERSION=""
SDK_NDK_VERSION=""
DETECTED_SDK_VERSION=""
SDK_SOURCE=""
PROJECT_NDK_SOURCE=""
RESOLVED_JAVA_HOME=""
ANDROID_CMDLINE_TOOLS_BIN=""

# Return success when $1 is greater than or equal to $2. Versions may omit
# minor or patch components, but are compared numerically as X.Y.Z.
version_at_least() {
    local actual="$1" required="$2"
    local -a actual_parts required_parts
    local i actual_part required_part

    actual="${actual#v}"
    required="${required#v}"
    IFS='.' read -r -a actual_parts <<< "$actual"
    IFS='.' read -r -a required_parts <<< "$required"

    for i in 0 1 2; do
        actual_part="${actual_parts[i]:-0}"
        required_part="${required_parts[i]:-0}"
        [[ "$actual_part" =~ ^[0-9]+$ && "$required_part" =~ ^[0-9]+$ ]] || return 1
        if ((10#$actual_part > 10#$required_part)); then
            return 0
        elif ((10#$actual_part < 10#$required_part)); then
            return 1
        fi
    done
    return 0
}

# ---------------------------------------------------------------------------
# Color support (auto-detect TTY)
# ---------------------------------------------------------------------------
if [ -t 1 ] && [ -t 2 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    DIM='\033[2m'
    RESET='\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' CYAN='' BOLD='' DIM='' RESET=''
fi

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------
info()    { echo -e "${BLUE}ℹ${RESET}  $*"; }
ok()      { echo -e "${GREEN}✅${RESET} $*"; }
warn()    { echo -e "${YELLOW}⚠️${RESET}  $*"; }
fail()    { echo -e "${RED}❌${RESET} $*"; }
header()  { echo -e "\n${BOLD}${CYAN}$*${RESET}"; }
divider() { echo -e "${DIM}────────────────────────────────────────────────────────${RESET}"; }

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------
MISSING=0
FIX_MODE=0
USER_SDK_OVERRIDE=""
CHECKS_PASSED=0
CHECKS_WARNED=0
CHECKS_FAILED=0

# ---------------------------------------------------------------------------
# Architecture detection
# ---------------------------------------------------------------------------
detect_arch() {
    local machine
    machine=$(uname -m)
    case "$machine" in
        x86_64)        ARCH="x86_64"  ;;
        aarch64|arm64) ARCH="aarch64" ;;
        armv7l)        ARCH="armv7l"  ;;
        *)
            warn "Unknown architecture: $machine. Defaulting to x86_64."
            ARCH="x86_64"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Expo SDK detection
# ---------------------------------------------------------------------------

# Look up version requirements for a given SDK version.
# Sets: MIN_NODE_VERSION, MIN_JDK_VERSION, ANDROID_PLATFORM_VERSION,
# ANDROID_BUILD_TOOLS_VERSION, ANDROID_NDK_VERSION
resolve_sdk_versions() {
    local sdk="$1"
    local entry entry_sdk min_node min_jdk compile_sdk build_tools ndk
    for entry in "${SDK_VERSION_MAP[@]}"; do
        IFS='|' read -r entry_sdk min_node min_jdk compile_sdk build_tools ndk <<< "$entry"
        if [ "$entry_sdk" = "$sdk" ]; then
            MIN_NODE_VERSION="$min_node"
            MIN_JDK_VERSION="$min_jdk"
            ANDROID_PLATFORM_VERSION="android-${compile_sdk}"
            ANDROID_BUILD_TOOLS_VERSION="$build_tools"
            ANDROID_NDK_VERSION="$ndk"
            SDK_NDK_VERSION="$ndk"
            DETECTED_SDK_VERSION="$sdk"
            return 0
        fi
    done
    return 1
}

# Detected project package manager (npm, yarn, pnpm, bun, or empty string)
PROJECT_PKG_MANAGER=""

# Detect the Expo SDK version and the project's package manager in a single
# walk up from $PWD. The first package.json with a usable "expo" dependency
# sets the SDK; the first one with a packageManager field or adjacent lock file
# sets the package manager. Falls back to the latest known SDK only when no
# Expo dependency is found anywhere in the current directory tree.
detect_project() {
    # --sdk override short-circuits SDK detection (the PM is still scanned for)
    local sdk_resolved=0
    if [ -n "$USER_SDK_OVERRIDE" ]; then
        if resolve_sdk_versions "$USER_SDK_OVERRIDE"; then
            SDK_SOURCE="--sdk flag"
        else
            fail "Expo SDK $USER_SDK_OVERRIDE is not supported by this version of $SCRIPT_NAME."
            info "Update $SCRIPT_NAME or use a supported SDK version."
            exit 2
        fi
        sdk_resolved=1
    fi

    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/package.json" ]; then
            # Expo SDK version: "expo": "~XX.Y.Z" | "^XX.Y.Z" | "XX.Y.Z"
            if [ "$sdk_resolved" -eq 0 ]; then
                local expo_ver
                # `|| true`: grep returns non-zero on no match, which would trip set -e/pipefail
                expo_ver=$(grep -oP '"expo"\s*:\s*"[~^]?\K\d+' "$dir/package.json" 2>/dev/null | head -1 || true)
                if [ -n "$expo_ver" ]; then
                    if resolve_sdk_versions "$expo_ver"; then
                        SDK_SOURCE="$dir/package.json"
                        sdk_resolved=1
                    else
                        fail "Expo SDK $expo_ver found in $dir/package.json but is not supported by this version of $SCRIPT_NAME."
                        info "Update $SCRIPT_NAME before diagnosing or fixing this project."
                        exit 2
                    fi
                fi
            fi

            # Package manager: packageManager field, else nearest lock file
            if [ -z "$PROJECT_PKG_MANAGER" ]; then
                local pm_field
                pm_field=$(grep -oP '"packageManager"\s*:\s*"\K[^@"]+' "$dir/package.json" 2>/dev/null | head -1 || true)
                if [ -n "$pm_field" ]; then
                    PROJECT_PKG_MANAGER="$pm_field"
                elif [ -f "$dir/bun.lockb" ] || [ -f "$dir/bun.lock" ]; then
                    PROJECT_PKG_MANAGER="bun"
                elif [ -f "$dir/pnpm-lock.yaml" ]; then
                    PROJECT_PKG_MANAGER="pnpm"
                elif [ -f "$dir/yarn.lock" ]; then
                    PROJECT_PKG_MANAGER="yarn"
                elif [ -f "$dir/package-lock.json" ]; then
                    PROJECT_PKG_MANAGER="npm"
                fi
            fi
        fi

        # Stop early once both are known
        [ "$sdk_resolved" -eq 1 ] && [ -n "$PROJECT_PKG_MANAGER" ] && break

        dir=$(dirname "$dir")
    done

    # Fallback to latest known defaults if no project SDK was detected
    if [ "$sdk_resolved" -eq 0 ]; then
        resolve_sdk_versions "$DEFAULT_SDK_VERSION"
        SDK_SOURCE="latest defaults (no project detected)"
    fi
}

# A native project can explicitly pin an NDK different from Expo's default.
# Honor a literal Gradle value so diagnosis matches the NDK Gradle will use.
detect_project_ndk_override() {
    local project_dir file override
    PROJECT_NDK_SOURCE=""
    [ -n "$SDK_SOURCE" ] && [ -f "$SDK_SOURCE" ] || return 0
    project_dir=$(dirname "$SDK_SOURCE")

    for file in "$project_dir/android/build.gradle" "$project_dir/android/app/build.gradle" "$project_dir/android/build.gradle.kts" "$project_dir/android/app/build.gradle.kts"; do
        [ -f "$file" ] || continue
        override=$(grep -oP "ndkVersion\\s*(?:=|\\s)\\s*['\"]\\K[0-9]+(?:\\.[0-9]+)+" "$file" | head -1 || true)
        if [ -n "$override" ]; then
            PROJECT_NDK_SOURCE="$file"
            if [ "$override" != "$SDK_NDK_VERSION" ]; then
                warn "Project overrides Expo SDK NDK ${SDK_NDK_VERSION} with ${override} in $file."
                ANDROID_NDK_VERSION="$override"
            fi
            return 0
        fi
    done
}

# ---------------------------------------------------------------------------
# Package manager detection
# ---------------------------------------------------------------------------
PKG_MANAGER=""

detect_pkg_manager() {
    if command -v apt-get &>/dev/null; then
        PKG_MANAGER="apt"
    elif command -v dnf &>/dev/null; then
        PKG_MANAGER="dnf"
    elif command -v pacman &>/dev/null; then
        PKG_MANAGER="pacman"
    else
        fail "No supported package manager found (apt, dnf, pacman)."
        fail "Please install dependencies manually."
        exit 1
    fi
}

# Wrapper: install one or more packages via detected package manager.
# Usage: install_pkg <apt_name> <dnf_name> <pacman_name>
# Pass "-" if a package is not needed on that distro.
install_pkg() {
    local apt_name="$1" dnf_name="$2" pacman_name="$3"
    case "$PKG_MANAGER" in
        apt)
            [ "$apt_name" != "-" ] && sudo apt-get install -y "$apt_name"
            ;;
        dnf)
            [ "$dnf_name" != "-" ] && sudo dnf install -y "$dnf_name"
            ;;
        pacman)
            [ "$pacman_name" != "-" ] && sudo pacman -S --noconfirm "$pacman_name"
            ;;
    esac
}

# Install multiple packages at once (same name across distros).
install_common_pkgs() {
    case "$PKG_MANAGER" in
        apt)    sudo apt-get install -y "$@" ;;
        dnf)    sudo dnf install -y "$@" ;;
        pacman) sudo pacman -S --noconfirm "$@" ;;
    esac
}

# Update package manager cache.
update_pkg_cache() {
    case "$PKG_MANAGER" in
        apt)    sudo apt-get update ;;
        dnf)    sudo dnf check-update || true ;;
        pacman) sudo pacman -Sy ;;
    esac
}

# ---------------------------------------------------------------------------
# Check helpers
# ---------------------------------------------------------------------------
check_cmd() {
    local cmd="$1"
    if command -v "$cmd" &>/dev/null; then
        ok "$cmd is installed: ${DIM}$(command -v "$cmd")${RESET}"
        ((CHECKS_PASSED++)) || true
        return 0
    else
        fail "$cmd is not installed."
        MISSING=1
        ((CHECKS_FAILED++)) || true
        return 1
    fi
}

check_env_dir() {
    local var_name="$1"
    local var_value="${!var_name:-}"

    if [ -z "$var_value" ]; then
        fail "Environment variable $var_name is not set."
        MISSING=1
        ((CHECKS_FAILED++)) || true
        return 1
    elif [ ! -d "$var_value" ]; then
        fail "$var_name is set to '$var_value', but the directory does not exist."
        MISSING=1
        ((CHECKS_FAILED++)) || true
        return 1
    else
        ok "$var_name is set: ${DIM}$var_value${RESET}"
        ((CHECKS_PASSED++)) || true
        return 0
    fi
}

# ---------------------------------------------------------------------------
# Individual checks
# ---------------------------------------------------------------------------
check_basic_utils() {
    header "📦 Basic Utilities & Build Tools"
    check_cmd curl  || true
    check_cmd git   || true
    check_cmd unzip || true
    check_cmd wget  || true

    # Build tools (distro-specific names)
    if command -v gcc &>/dev/null && command -v make &>/dev/null; then
        ok "Build essentials (gcc, make) are installed."
        ((CHECKS_PASSED++)) || true
    else
        fail "Build essentials (gcc, make) are not fully installed."
        MISSING=1
        ((CHECKS_FAILED++)) || true
    fi
}

check_node() {
    header "🟢 Node.js & Package Managers"

    if ! command -v node &>/dev/null; then
        fail "Node.js is not installed."
        MISSING=1
        ((CHECKS_FAILED++)) || true
    else
        local node_version
        node_version=$(node -v | sed 's/^v//')
        if ! version_at_least "$node_version" "$MIN_NODE_VERSION"; then
            fail "Node.js v$node_version is installed, but v${MIN_NODE_VERSION}+ is required for Expo SDK ${DETECTED_SDK_VERSION}."
            MISSING=1
            ((CHECKS_FAILED++)) || true
        else
            ok "Node.js is installed: ${DIM}$(node -v)${RESET}"
            ((CHECKS_PASSED++)) || true
        fi
    fi

    check_cmd npm || true

    # Check the project's package manager if it differs from npm
    if [ -n "$PROJECT_PKG_MANAGER" ] && [ "$PROJECT_PKG_MANAGER" != "npm" ]; then
        if command -v "$PROJECT_PKG_MANAGER" &>/dev/null; then
            ok "$PROJECT_PKG_MANAGER is installed: ${DIM}$(command -v "$PROJECT_PKG_MANAGER")${RESET}"
            ((CHECKS_PASSED++)) || true
        else
            fail "$PROJECT_PKG_MANAGER is required by this project but not installed."
            MISSING=1
            ((CHECKS_FAILED++)) || true
        fi
    fi
}

check_eas() {
    header "⚙️  EAS CLI"
    if ! check_cmd eas; then
        info "Install with: ${BOLD}npm install -g eas-cli${RESET}"
    fi
}

check_java() {
    header "☕ Java JDK (OpenJDK $MIN_JDK_VERSION+ required)"

    if ! command -v java &>/dev/null; then
        fail "Java is not installed."
        MISSING=1
        ((CHECKS_FAILED++)) || true
    else
        local java_version
        java_version=$(java -version 2>&1 | head -n1 | grep -oP '(?<=\")\d+' | head -1 || true)
        if [ -n "$java_version" ] && [ "$java_version" -lt "$MIN_JDK_VERSION" ]; then
            fail "Java $java_version is installed, but version ${MIN_JDK_VERSION}+ is required."
            MISSING=1
            ((CHECKS_FAILED++)) || true
        else
            ok "Java is installed: ${DIM}version ${java_version:-unknown}${RESET}"
            ((CHECKS_PASSED++)) || true
        fi
    fi

    if ! command -v javac &>/dev/null; then
        fail "Java compiler (javac) is not installed. Install a full JDK, not a Java runtime only."
        MISSING=1
        ((CHECKS_FAILED++)) || true
    else
        local javac_version
        javac_version=$(javac -version 2>&1 | grep -oP '\d+(?:\.\d+){0,2}' | head -1 || true)
        if ! version_at_least "${javac_version:-0}" "$MIN_JDK_VERSION"; then
            fail "Java compiler version ${javac_version:-unknown} is installed, but version ${MIN_JDK_VERSION}+ is required."
            MISSING=1
            ((CHECKS_FAILED++)) || true
        else
            ok "Java compiler is installed: ${DIM}version $javac_version${RESET}"
            ((CHECKS_PASSED++)) || true
        fi
    fi

    check_env_dir JAVA_HOME || true
    if [ -n "${JAVA_HOME:-}" ] && [ -d "${JAVA_HOME:-}" ] && [ ! -x "$JAVA_HOME/bin/javac" ]; then
        fail "JAVA_HOME points to '$JAVA_HOME', but it does not contain bin/javac."
        MISSING=1
        ((CHECKS_FAILED++)) || true
    fi
}

ndk_revision() {
    local ndk_dir="$1"
    [ -f "$ndk_dir/source.properties" ] || return 1
    awk -F '=' '$1 ~ /^[[:space:]]*Pkg.Revision[[:space:]]*$/ { value=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); print value; exit }' "$ndk_dir/source.properties"
}

list_incomplete_ndk_dirs() {
    local ndk_root="$1" candidate name
    [ -d "$ndk_root" ] || return 0
    (
        shopt -s nullglob
        for candidate in "$ndk_root"/*; do
            name=$(basename "$candidate")
            [[ "$name" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && [ -d "$candidate" ] && [ ! -f "$candidate/source.properties" ] && printf '%s\n' "$name"
        done
    ) | sort | awk 'NR == 1 { result = $0; next } { result = result ", " $0 } END { printf "%s", result }'
}

clean_incomplete_ndk_dirs() {
    local ndk_root="$1" candidate name
    [ -d "$ndk_root" ] || return 0
    (
        shopt -s nullglob
        for candidate in "$ndk_root"/*; do
            name=$(basename "$candidate")
            [[ "$name" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && [ -d "$candidate" ] && [ ! -f "$candidate/source.properties" ] || continue
            warn "Removing incomplete Android NDK installation: $candidate"
            rm -rf -- "$candidate"
        done
    )
}

check_android_sdk() {
    header "🤖 Android SDK (${ANDROID_PLATFORM_VERSION}, build-tools ${ANDROID_BUILD_TOOLS_VERSION}, NDK ${ANDROID_NDK_VERSION})"

    check_env_dir ANDROID_HOME || true

    local sdk_dir="${ANDROID_HOME:-}"
    if [ -n "$sdk_dir" ] && [ -d "$sdk_dir" ]; then
        if [ -d "$sdk_dir/cmdline-tools" ]; then
            ok "cmdline-tools directory found."
            ((CHECKS_PASSED++)) || true
        else
            fail "cmdline-tools directory is missing."
            MISSING=1
            ((CHECKS_FAILED++)) || true
        fi

        if [ -d "$sdk_dir/platform-tools" ]; then
            ok "platform-tools directory found."
            ((CHECKS_PASSED++)) || true
        else
            fail "platform-tools directory is missing."
            MISSING=1
            ((CHECKS_FAILED++)) || true
        fi

        if [ -d "$sdk_dir/build-tools/${ANDROID_BUILD_TOOLS_VERSION}" ]; then
            ok "build-tools ${ANDROID_BUILD_TOOLS_VERSION} found."
            ((CHECKS_PASSED++)) || true
        elif [ -d "$sdk_dir/build-tools" ]; then
            local installed_bt
            installed_bt=$(list_android_versions "$sdk_dir/build-tools")
            fail "build-tools ${installed_bt:-none} found, but ${ANDROID_BUILD_TOOLS_VERSION} is required for SDK ${DETECTED_SDK_VERSION}."
            MISSING=1
            ((CHECKS_FAILED++)) || true
        else
            fail "build-tools directory is missing."
            MISSING=1
            ((CHECKS_FAILED++)) || true
        fi

        if [ -d "$sdk_dir/platforms/${ANDROID_PLATFORM_VERSION}" ]; then
            ok "${ANDROID_PLATFORM_VERSION} platform found."
            ((CHECKS_PASSED++)) || true
        elif [ -d "$sdk_dir/platforms" ]; then
            local installed_plat
            installed_plat=$(list_android_versions "$sdk_dir/platforms")
            fail "Platforms ${installed_plat:-none} found, but ${ANDROID_PLATFORM_VERSION} is required for SDK ${DETECTED_SDK_VERSION}."
            MISSING=1
            ((CHECKS_FAILED++)) || true
        else
            fail "No Android platforms installed (need ${ANDROID_PLATFORM_VERSION})."
            MISSING=1
            ((CHECKS_FAILED++)) || true
        fi

        local required_ndk_dir="$sdk_dir/ndk/${ANDROID_NDK_VERSION}"
        local installed_ndk_revision
        installed_ndk_revision=$(ndk_revision "$required_ndk_dir" || true)
        if [ "$installed_ndk_revision" = "$ANDROID_NDK_VERSION" ]; then
            ok "NDK ${ANDROID_NDK_VERSION} found."
            ((CHECKS_PASSED++)) || true
        elif [ -d "$required_ndk_dir" ]; then
            fail "NDK ${ANDROID_NDK_VERSION} is incomplete or reports version ${installed_ndk_revision:-unknown}."
            MISSING=1
            ((CHECKS_FAILED++)) || true
        else
            fail "NDK ${ANDROID_NDK_VERSION} is missing."
            MISSING=1
            ((CHECKS_FAILED++)) || true
        fi

        local incomplete_ndks
        incomplete_ndks=$(list_incomplete_ndk_dirs "$sdk_dir/ndk")
        if [ -n "$incomplete_ndks" ]; then
            warn "Incomplete NDK installations detected: $incomplete_ndks. Run --fix to remove them."
            ((CHECKS_WARNED++)) || true
        fi

        if command -v adb &>/dev/null; then
            ok "adb is in PATH: ${DIM}$(command -v adb)${RESET}"
            ((CHECKS_PASSED++)) || true
        else
            warn "adb is not in PATH. Add ${BOLD}\$ANDROID_HOME/platform-tools${RESET} to your PATH."
            ((CHECKS_WARNED++)) || true
        fi
    fi
}

# Print directory names as a comma-separated list without relying on ls order.
list_android_versions() {
    local parent="$1" child name
    (
        shopt -s nullglob
        for child in "$parent"/*; do
            [ -d "$child" ] || continue
            name=$(basename "$child")
            printf '%s\n' "$name"
        done
    ) | sort | awk 'NR == 1 { result = $0; next } { result = result ", " $0 } END { printf "%s", result }'
}

check_watchman() {
    header "👀 Watchman"

    if command -v watchman &>/dev/null; then
        ok "Watchman is installed."
        ((CHECKS_PASSED++)) || true
    elif version_at_least "$DETECTED_SDK_VERSION" "56.0.0"; then
        ok "Watchman is not installed (not required for Expo SDK 56+)."
        ((CHECKS_PASSED++)) || true
    else
        warn "Watchman is not installed (optional, but recommended for Metro bundler performance)."
        ((CHECKS_WARNED++)) || true
    fi
}

# `firewall-cmd --get-active-zones` prints a non-indented zone header, which
# may end in " (default)", followed by indented interface/source lines.
parse_firewalld_active_zones() {
    awk '/^[^[:space:]]/ { print $1 }'
}

# Return success if a firewalld --list-ports value explicitly permits Metro.
# firewalld may report either a single port (8081/tcp) or a range that covers it.
firewalld_ports_allow_metro() {
    local ports="$1" port_spec start_port end_port
    for port_spec in $ports; do
        if [ "$port_spec" = "8081/tcp" ]; then
            return 0
        fi
        if [[ "$port_spec" =~ ^([0-9]+)-([0-9]+)/tcp$ ]]; then
            start_port="${BASH_REMATCH[1]}"
            end_port="${BASH_REMATCH[2]}"
            if ((10#$start_port <= 8081 && 8081 <= 10#$end_port)); then
                return 0
            fi
        fi
    done
    return 1
}

# Metro is accessed through the host network. Only the default zone is a safe
# automatic target; container zones (for example, docker) are intentionally skipped.
get_active_default_firewalld_zone() {
    local active_zones="$1" default_zone="$2"
    if parse_firewalld_active_zones <<< "$active_zones" | grep -Fxq "$default_zone"; then
        printf '%s' "$default_zone"
        return 0
    fi
    return 1
}

check_firewall() {
    header "🛡️  Firewall (UFW / Firewalld)"

    local ufw_active=0 firewalld_active=0
    if command -v ufw &>/dev/null && systemctl is-active --quiet ufw 2>/dev/null; then
        ufw_active=1
    fi
    if command -v firewall-cmd &>/dev/null && systemctl is-active --quiet firewalld 2>/dev/null; then
        firewalld_active=1
    fi

    if [ "$ufw_active" -eq 0 ] && [ "$firewalld_active" -eq 0 ]; then
        ok "Firewall is inactive or not blocking local Metro traffic."
        ((CHECKS_PASSED++)) || true
        return 0
    fi

    if [ "$ufw_active" -eq 1 ]; then
        local ufw_status_output
        if ufw_status_output=$(sudo -n ufw status 2>/dev/null); then
            if echo "$ufw_status_output" | grep -qE "8081/tcp.*ALLOW"; then
                ok "UFW firewall is active and port 8081/tcp is allowed for Metro."
                ((CHECKS_PASSED++)) || true
            else
                warn "UFW firewall is active, but port 8081/tcp is not in the allow list."
                info "Allow port 8081 with: ${BOLD}sudo ufw allow 8081/tcp comment 'Expo'${RESET}"
                ((CHECKS_WARNED++)) || true
            fi
        else
            ok "UFW firewall is active. (Run with sudo to verify port 8081 rules)"
            info "If LAN connection to Metro fails on physical devices, allow port 8081: ${BOLD}sudo ufw allow 8081/tcp comment 'Expo'${RESET}"
            ((CHECKS_PASSED++)) || true
        fi
    fi

    if [ "$firewalld_active" -eq 1 ]; then
        local zone runtime_ports permanent_ports active_zones default_zone
        if active_zones=$(sudo -n firewall-cmd --get-active-zones 2>/dev/null) && default_zone=$(sudo -n firewall-cmd --get-default-zone 2>/dev/null); then
            if ! zone=$(get_active_default_firewalld_zone "$active_zones" "$default_zone"); then
                warn "firewalld default zone '$default_zone' is not active; not checking container or unknown zones automatically."
                ((CHECKS_WARNED++)) || true
                return 0
            fi
            runtime_ports=$(sudo -n firewall-cmd --zone="$zone" --list-ports 2>/dev/null || true)
            permanent_ports=$(sudo -n firewall-cmd --permanent --zone="$zone" --list-ports 2>/dev/null || true)
            if firewalld_ports_allow_metro "$runtime_ports" && firewalld_ports_allow_metro "$permanent_ports"; then
                ok "firewalld default zone '$zone' allows port 8081/tcp for Metro."
                ((CHECKS_PASSED++)) || true
            else
                warn "firewalld default zone '$zone' does not allow port 8081/tcp in both runtime and permanent rules."
                info "Allow it with: ${BOLD}sudo firewall-cmd --zone=$zone --add-port=8081/tcp --permanent && sudo firewall-cmd --reload${RESET}"
                ((CHECKS_WARNED++)) || true
            fi
        else
            ok "firewalld is active. (Run with sudo to verify port 8081 rules)"
            info "If LAN connection to Metro fails, allow port 8081 in its active zone with: ${BOLD}sudo firewall-cmd --get-active-zones${RESET}"
            ((CHECKS_PASSED++)) || true
        fi
    fi
}

