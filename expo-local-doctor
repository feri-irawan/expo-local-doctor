detect_shell_profile() {
    local shell_name
    shell_name=$(basename "${SHELL:-bash}")
    case "$shell_name" in
        bash) SHELL_PROFILE="$HOME/.bashrc"; SHELL_RELOAD_HINT="source ~/.bashrc" ;;
        zsh)  SHELL_PROFILE="$HOME/.zshrc"; SHELL_RELOAD_HINT="source ~/.zshrc" ;;
        fish) SHELL_PROFILE="$HOME/.config/fish/config.fish"; SHELL_RELOAD_HINT="source ~/.config/fish/config.fish" ;;
        *)
            warn "Unsupported login shell '$shell_name'; using ~/.bashrc for environment setup."
            SHELL_PROFILE="$HOME/.bashrc"
            SHELL_RELOAD_HINT="source ~/.bashrc"
            ;;
    esac
    SHELL_PROFILE_TYPE="$shell_name"
}

# Replace only the block owned by this tool, preserving all user configuration.
configure_shell_profile() {
    local java_home="$1" android_home="$2" cmdline_tools_bin="$3"
    local profile_dir tmp_profile start_markers end_markers

    [ -n "$java_home" ] && [ -n "$android_home" ] && [ -n "$cmdline_tools_bin" ] || return 0
    detect_shell_profile
    profile_dir=$(dirname "$SHELL_PROFILE")
    mkdir -p "$profile_dir"
    touch "$SHELL_PROFILE"
    start_markers=$(grep -c '^# >>> expo-local-doctor >>>$' "$SHELL_PROFILE" || true)
    end_markers=$(grep -c '^# <<< expo-local-doctor <<<$' "$SHELL_PROFILE" || true)
    if [ "$start_markers" -ne "$end_markers" ] || [ "$start_markers" -gt 1 ]; then
        fail "Refusing to update ${SHELL_PROFILE}: malformed expo-local-doctor configuration block."
        info "Repair the '# >>> expo-local-doctor >>>' / '# <<< expo-local-doctor <<<' markers and run again."
        return 1
    fi
    tmp_profile=$(mktemp "${SHELL_PROFILE}.XXXXXX")

    awk '/^# >>> expo-local-doctor >>>$/ { skip=1; next } /^# <<< expo-local-doctor <<</ { skip=0; next } !skip { print }' "$SHELL_PROFILE" > "$tmp_profile"
    {
        echo "# >>> expo-local-doctor >>>"
        if [ "$SHELL_PROFILE_TYPE" = "fish" ]; then
            printf 'set -gx JAVA_HOME "%s"\n' "$java_home"
            printf 'set -gx ANDROID_HOME "%s"\n' "$android_home"
            printf 'fish_add_path -g "%s" "$ANDROID_HOME/emulator" "$ANDROID_HOME/platform-tools"\n' "$cmdline_tools_bin"
        else
            printf 'export JAVA_HOME="%s"\n' "$java_home"
            printf 'export ANDROID_HOME="%s"\n' "$android_home"
            printf 'export PATH="$PATH:$ANDROID_HOME/emulator:%s:$ANDROID_HOME/platform-tools"\n' "$cmdline_tools_bin"
        fi
        echo "# <<< expo-local-doctor <<<"
    } >> "$tmp_profile"
    mv "$tmp_profile" "$SHELL_PROFILE"
    ok "Environment configuration updated in ${SHELL_PROFILE}."
}

fix_java() {
    local needs_install=0 java_version="" target_jdk_version="$MIN_JDK_VERSION"
    if ! command -v java &>/dev/null; then
        needs_install=1
    else
        java_version=$(java -version 2>&1 | head -n1 | grep -oP '(?<=")\d+' | head -1 || true)
        if [ -n "$java_version" ] && [ "$java_version" -lt "$MIN_JDK_VERSION" ]; then
            info "Java $java_version is installed but version ${MIN_JDK_VERSION} is required. Installing..."
            needs_install=1
        else
            [ -n "$java_version" ] && target_jdk_version="$java_version"
        fi
    fi

    if ! command -v javac &>/dev/null; then
        info "Java compiler (javac) is missing. Installing the JDK development package..."
        needs_install=1
    else
        local javac_version
        javac_version=$(javac -version 2>&1 | grep -oP '\d+' | head -1 || true)
        if ! version_at_least "${javac_version:-0}" "$MIN_JDK_VERSION"; then
            info "Java compiler $javac_version is installed but version ${MIN_JDK_VERSION} is required. Installing..."
            needs_install=1
        fi
    fi

    if [ "$needs_install" -eq 1 ]; then
        header "☕ Installing OpenJDK ${target_jdk_version} development package..."
        install_pkg "openjdk-${target_jdk_version}-jdk" "java-${target_jdk_version}-openjdk-devel" "jdk${target_jdk_version}-openjdk"
        ok "OpenJDK ${target_jdk_version} development package installed."
    fi

    if ! command -v javac &>/dev/null; then
        fail "javac is still unavailable after JDK installation."
        exit 1
    fi

    # Resolve the JDK home from the active java binary
    local java_home_path
    java_home_path=$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")

    RESOLVED_JAVA_HOME="$java_home_path"
    export JAVA_HOME="$java_home_path"
    ok "JAVA_HOME resolved to ${java_home_path}"
}

# Locate the cmdline-tools bin directory that contains sdkmanager.
# Prefers the 'latest' channel, falls back to any versioned install.
# Echoes the bin directory on success; returns non-zero if none found.
find_cmdline_tools_bin() {
    local sdk_root="$1" candidate
    if [ -x "$sdk_root/cmdline-tools/latest/bin/sdkmanager" ]; then
        echo "$sdk_root/cmdline-tools/latest/bin"
        return 0
    fi
    for candidate in "$sdk_root"/cmdline-tools/*/bin; do
        if [ -x "$candidate/sdkmanager" ]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

fix_android_sdk() {
    local sdk_dir="${ANDROID_HOME:-$HOME/Android/Sdk}"

    if [ -n "${ANDROID_HOME:-}" ] && [ -d "${ANDROID_HOME:-}" ] && [ -d "${ANDROID_HOME}/cmdline-tools" ]; then
        # SDK exists — check whether the required platform and build-tools are present
        local needs_update=0
        clean_incomplete_ndk_dirs "$sdk_dir/ndk"
        if [ ! -d "${ANDROID_HOME}/platforms/${ANDROID_PLATFORM_VERSION}" ]; then
            info "Missing ${ANDROID_PLATFORM_VERSION} — will install."
            needs_update=1
        fi
        if [ ! -d "${ANDROID_HOME}/build-tools/${ANDROID_BUILD_TOOLS_VERSION}" ]; then
            info "Missing build-tools ${ANDROID_BUILD_TOOLS_VERSION} — will install."
            needs_update=1
        fi
        if [ "$(ndk_revision "$sdk_dir/ndk/${ANDROID_NDK_VERSION}" || true)" != "$ANDROID_NDK_VERSION" ]; then
            info "Missing or incomplete NDK ${ANDROID_NDK_VERSION} — will install."
            needs_update=1
        fi

        if [ "$needs_update" -eq 0 ]; then
            ok "Android SDK is already configured with ${ANDROID_PLATFORM_VERSION}, build-tools ${ANDROID_BUILD_TOOLS_VERSION}, and NDK ${ANDROID_NDK_VERSION}."
            export ANDROID_HOME="$sdk_dir"
            if ANDROID_CMDLINE_TOOLS_BIN=$(find_cmdline_tools_bin "$sdk_dir"); then
                export PATH="$PATH:$ANDROID_HOME/emulator:$ANDROID_CMDLINE_TOOLS_BIN:$ANDROID_HOME/platform-tools"
            else
                fail "sdkmanager not found under ${sdk_dir}/cmdline-tools."
                exit 1
            fi
            return
        fi

        header "🤖 Updating Android SDK for SDK ${DETECTED_SDK_VERSION}..."
        export ANDROID_HOME="$sdk_dir"

        # Locate sdkmanager (handles installs that don't use the 'latest' channel)
        local cmdline_bin
        if ! cmdline_bin=$(find_cmdline_tools_bin "$sdk_dir"); then
            fail "sdkmanager not found under ${sdk_dir}/cmdline-tools."
            info "Reinstall the Android command-line tools, or unset ANDROID_HOME to let this script set them up."
            exit 1
        fi
        ANDROID_CMDLINE_TOOLS_BIN="$cmdline_bin"
        export PATH="$PATH:$ANDROID_HOME/emulator:$cmdline_bin:$ANDROID_HOME/platform-tools"

        info "Accepting Android SDK licenses..."
        yes | sdkmanager --licenses 2>/dev/null || true

        info "Installing ${ANDROID_PLATFORM_VERSION}, build-tools ${ANDROID_BUILD_TOOLS_VERSION}, and NDK ${ANDROID_NDK_VERSION}..."
        sdkmanager "platform-tools" "platforms;${ANDROID_PLATFORM_VERSION}" "build-tools;${ANDROID_BUILD_TOOLS_VERSION}" "ndk;${ANDROID_NDK_VERSION}"

        ok "Android SDK updated at ${sdk_dir}"
        return
    fi

    header "🤖 Installing Android SDK..."

    mkdir -p "$sdk_dir/cmdline-tools"

    local tools_url="https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip"

    info "Downloading Android command-line tools..."
    local tmp_zip
    tmp_zip=$(mktemp /tmp/cmdline-tools-XXXXXX.zip)
    wget -q --show-progress "$tools_url" -O "$tmp_zip"

    info "Extracting..."
    unzip -q "$tmp_zip" -d "$sdk_dir/cmdline-tools"
    rm -f "$tmp_zip"

    # Rename extracted folder to 'latest'
    if [ -d "$sdk_dir/cmdline-tools/cmdline-tools" ]; then
        mv "$sdk_dir/cmdline-tools/cmdline-tools" "$sdk_dir/cmdline-tools/latest"
    fi

    export ANDROID_HOME="$sdk_dir"
    ANDROID_CMDLINE_TOOLS_BIN="$ANDROID_HOME/cmdline-tools/latest/bin"
    export PATH="$PATH:$ANDROID_HOME/emulator:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools"

    info "Accepting Android SDK licenses..."
    yes | sdkmanager --licenses 2>/dev/null || true

    info "Installing platform-tools, ${ANDROID_PLATFORM_VERSION}, build-tools ${ANDROID_BUILD_TOOLS_VERSION}, and NDK ${ANDROID_NDK_VERSION}..."
    sdkmanager "platform-tools" "platforms;${ANDROID_PLATFORM_VERSION}" "build-tools;${ANDROID_BUILD_TOOLS_VERSION}" "ndk;${ANDROID_NDK_VERSION}"

    ok "Android SDK installed at ${sdk_dir}"
}

fix_watchman() {
    if command -v watchman &>/dev/null; then
        ok "Watchman is already installed."
        return
    fi

    if version_at_least "$DETECTED_SDK_VERSION" "56.0.0"; then
        ok "Watchman is not required for Expo SDK 56+; skipping installation."
        return
    fi

    header "👀 Installing Watchman..."

    case "$PKG_MANAGER" in
        apt)
            # Watchman may not be in default apt repos, try anyway
            if apt-cache show watchman &>/dev/null 2>&1; then
                sudo apt-get install -y watchman
                ok "Watchman installed via apt."
            else
                warn "Watchman is not available in apt repositories."
                info "Install manually: https://facebook.github.io/watchman/docs/install"
            fi
            ;;
        dnf)
            warn "Watchman is not available in default dnf repositories."
            info "Install manually: https://facebook.github.io/watchman/docs/install"
            ;;
        pacman)
            # Available in AUR, not official repos
            warn "Watchman is available in AUR. Install with: yay -S watchman-bin"
            ;;
    esac
}

fix_firewall() {
    local ufw_active=0 firewalld_active=0
    if command -v ufw &>/dev/null && systemctl is-active --quiet ufw 2>/dev/null; then
        ufw_active=1
    fi
    if command -v firewall-cmd &>/dev/null && systemctl is-active --quiet firewalld 2>/dev/null; then
        firewalld_active=1
    fi

    if [ "$ufw_active" -eq 0 ] && [ "$firewalld_active" -eq 0 ]; then
        ok "Firewall is inactive. No firewall rules needed."
        return
    fi

    if [ "$ufw_active" -eq 1 ]; then
        if sudo -n ufw status 2>/dev/null | grep -qE "8081/tcp.*ALLOW"; then
            ok "UFW rule for port 8081/tcp is already active."
        else
            header "🛡️  Configuring UFW Firewall for Expo Metro (Port 8081)..."
            sudo ufw allow 8081/tcp comment 'Expo'
            ok "UFW port 8081/tcp allowed."
        fi
    fi

    if [ "$firewalld_active" -eq 1 ]; then
        local zone active_zones default_zone changed=0 permanent_ports runtime_ports
        active_zones=$(sudo firewall-cmd --get-active-zones)
        default_zone=$(sudo firewall-cmd --get-default-zone)
        if ! zone=$(get_active_default_firewalld_zone "$active_zones" "$default_zone"); then
            warn "firewalld default zone '$default_zone' is not active; no firewall rule was changed."
            return 0
        fi

        permanent_ports=$(sudo firewall-cmd --permanent --zone="$zone" --list-ports)
        if firewalld_ports_allow_metro "$permanent_ports"; then
            ok "firewalld permanent rule set already allows port 8081/tcp in default zone '$zone'."
        else
            header "🛡️  Configuring firewalld default zone '$zone' for Expo Metro (Port 8081)..."
            sudo firewall-cmd --zone="$zone" --add-port=8081/tcp --permanent
            changed=1
        fi

        if [ "$changed" -eq 1 ]; then
            sudo firewall-cmd --reload
        fi

        runtime_ports=$(sudo firewall-cmd --zone="$zone" --list-ports)
        if firewalld_ports_allow_metro "$runtime_ports"; then
            ok "firewalld default zone '$zone' allows port 8081/tcp."
        else
            fail "firewalld default zone '$zone' still does not allow port 8081/tcp after reload."
            exit 1
        fi
    fi
}

